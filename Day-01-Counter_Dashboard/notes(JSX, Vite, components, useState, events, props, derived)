import {useState} from 'react';

export default function MyApp(){
  const [count, setCount] = useState(0);
  function handleClick(){
    setCount(count + 1);
  }
  return (
    <>
    <MyButton count={count} onClick={handleClick} />
    </>
  )
}


function MyButton({count, onClick}){
  return (
    <>
    <button onClick={onClick}> The button is pressed {count} times !! </button>
    </>
  )
}

3. State is data that a component remembers between renders. When state changes, React re-renders the component so the UI can reflect the new value.

4. Hooks are used for make changes in all the child components
Hooks are special React functions that let function components use React features such as state and effects.

